<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SerenadaApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SerenadaApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Serenada"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="#0B1220"
          RequestedTheme="Dark">
        <!-- Home screen: room creation and join -->
        <ScrollViewer x:Name="HomePanel"
                      Width="520"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16"
                        Margin="24,32">
                <TextBlock Text="Serenada"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#F8FAFC" />
                <TextBlock Text="Privacy-first video calling"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,16" />

                <TextBox x:Name="RoomUrlInput"
                         PlaceholderText="Paste a call link or room ID..."
                         PlaceholderForeground="#94A3B8"
                         Background="#111827"
                         Foreground="#F8FAFC"
                         BorderBrush="#64748B"
                         CornerRadius="8"
                         Padding="12,10" />

                <Button x:Name="JoinButton"
                        Content="Join Call"
                        Background="#2563EB"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="24,12"
                        HorizontalAlignment="Stretch"
                        Click="OnJoinClick" />

                <Button x:Name="CreateRoomButton"
                        Content="Create New Room"
                        Background="#334155"
                        Foreground="#F8FAFC"
                        BorderBrush="#64748B"
                        CornerRadius="8"
                        Padding="24,12"
                        HorizontalAlignment="Stretch"
                        Click="OnCreateRoomClick" />

                <Border Background="#111827"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Saved rooms"
                                   Foreground="#F8FAFC"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Keep named rooms and share links that save the room on another device."
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="SavedRoomNameInput"
                                 PlaceholderText="Room name"
                                 PlaceholderForeground="#94A3B8"
                                 MaxLength="120"
                                 Background="#0B1220"
                                 Foreground="#F8FAFC"
                                 BorderBrush="#64748B"
                                 CornerRadius="8"
                                 Padding="12,9" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Save pasted room"
                                    Background="#334155"
                                    Foreground="#F8FAFC"
                                    BorderBrush="#64748B"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    HorizontalAlignment="Stretch"
                                    Click="OnSaveRoomLinkClick" />
                            <Button x:Name="CreateSavedRoomButton"
                                    Grid.Column="1"
                                    Content="Create named room"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    HorizontalAlignment="Stretch"
                                    Click="OnCreateSavedRoomClick" />
                        </Grid>
                        <TextBlock x:Name="SavedRoomsEmptyText"
                                   Text="No saved rooms yet."
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   Margin="0,8" />
                        <StackPanel x:Name="SavedRoomsList"
                                    Spacing="8" />
                    </StackPanel>
                </Border>

                <Button Content="Settings"
                        Background="#111827"
                        Foreground="#F8FAFC"
                        BorderBrush="#64748B"
                        CornerRadius="8"
                        Padding="24,10"
                        HorizontalAlignment="Stretch"
                        Click="OnSettingsClick" />

                <TextBlock x:Name="StatusLabel"
                           Text=""
                           FontSize="13"
                           Foreground="#E2E8F0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="SettingsPanel"
                Visibility="Collapsed"
                Width="440"
                Padding="28"
                CornerRadius="16"
                Background="#111827"
                BorderBrush="#64748B"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <ScrollViewer MaxHeight="680"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings"
                               Foreground="#F8FAFC"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Text="These preferences apply when you join the next call."
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Server host"
                               Foreground="#F8FAFC" />
                    <ComboBox x:Name="ServerHostInput"
                              IsEditable="True"
                              PlaceholderText="Server hostname"
                              Background="#0B1220"
                              Foreground="#F8FAFC"
                              BorderBrush="#64748B"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="serenada.app" />
                        <ComboBoxItem Content="serenada-app.ru" />
                    </ComboBox>
                    <TextBlock Text="Choose Global, Russia, or type a custom Serenada host."
                               Foreground="#CBD5E1"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Display name"
                               Foreground="#F8FAFC" />
                    <TextBox x:Name="DisplayNameInput"
                             PlaceholderText="Your name"
                             PlaceholderForeground="#94A3B8"
                             MaxLength="80"
                             Background="#0B1220"
                             Foreground="#F8FAFC"
                             BorderBrush="#64748B"
                             CornerRadius="8"
                             Padding="12,10" />
                </StackPanel>

                <ToggleSwitch x:Name="StartWithMicrophoneToggle"
                              Header="Microphone on when joining"
                              Foreground="#F8FAFC"
                              IsOn="True" />

                <ToggleSwitch x:Name="StartWithCameraToggle"
                              Header="Camera on when joining"
                              Foreground="#F8FAFC"
                              IsOn="True" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Windows device permissions"
                               Foreground="#CBD5E1" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Microphone"
                                Background="#0B1220"
                                Foreground="#F8FAFC"
                                BorderBrush="#64748B"
                                CornerRadius="8"
                                Padding="12,9"
                                HorizontalAlignment="Stretch"
                                Click="OnMicrophonePrivacyClick" />
                        <Button Grid.Column="1"
                                Content="Camera"
                                Background="#0B1220"
                                Foreground="#F8FAFC"
                                BorderBrush="#64748B"
                                CornerRadius="8"
                                Padding="12,9"
                                HorizontalAlignment="Stretch"
                                Click="OnCameraPrivacyClick" />
                    </Grid>
                </StackPanel>

                <Button Content="Open diagnostic log folder"
                        Background="#0B1220"
                        Foreground="#F8FAFC"
                        BorderBrush="#64748B"
                        CornerRadius="8"
                        Padding="12,9"
                        HorizontalAlignment="Stretch"
                        Click="OnOpenLogsClick" />

                <TextBlock x:Name="SettingsStatusLabel"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Background="#334155"
                            Foreground="#F8FAFC"
                            CornerRadius="8"
                            Padding="20,11"
                            HorizontalAlignment="Stretch"
                            Click="OnSettingsCancelClick" />
                    <Button x:Name="SettingsSaveButton"
                            Grid.Column="1"
                            Content="Save"
                            Background="#2563EB"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="20,11"
                            HorizontalAlignment="Stretch"
                            Click="OnSettingsSaveClick" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Call screen (hidden until a call is active) -->
        <Grid x:Name="CallPanel" Visibility="Collapsed" />
    </Grid>
</Window>
