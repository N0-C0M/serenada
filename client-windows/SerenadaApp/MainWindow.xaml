<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SerenadaApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SerenadaApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Serenada"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <!-- Home screen: room creation and join -->
        <StackPanel x:Name="HomePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Width="400">
            <TextBlock Text="Serenada"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#F8FAFC" />
            <TextBlock Text="Privacy-first video calling"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="#64748B"
                       Margin="0,0,0,16" />

            <TextBox x:Name="RoomUrlInput"
                     PlaceholderText="Paste a call link..."
                     Background="#1E293B"
                     Foreground="#F8FAFC"
                     BorderBrush="#334155"
                     CornerRadius="8"
                     Padding="12,10" />

            <Button x:Name="JoinButton"
                    Content="Join Call"
                    Background="#2563EB"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="24,12"
                    HorizontalAlignment="Stretch"
                    Click="OnJoinClick" />

            <Button x:Name="CreateRoomButton"
                    Content="Create New Room"
                    Background="#334155"
                    Foreground="#F8FAFC"
                    CornerRadius="8"
                    Padding="24,12"
                    HorizontalAlignment="Stretch"
                    Click="OnCreateRoomClick" />

            <TextBlock x:Name="StatusLabel"
                       Text=""
                       FontSize="12"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Call screen (hidden until a call is active) -->
        <Grid x:Name="CallPanel" Visibility="Collapsed" />
    </Grid>
</Window>
