<UserControl
    x:Class="Serenada.CallUI.CallScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Serenada.CallUI">

    <Grid Background="#0F172A">
        <!-- Layer 0: Remote video background (full-screen) -->
        <Grid x:Name="RemoteVideoGrid"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="RemoteVideoPlaceholder"
                  Background="#1E293B">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <FontIcon Glyph=""
                              FontSize="64"
                              Foreground="#475569" />
                    <TextBlock x:Name="CallStatusText"
                               Text="Waiting for someone to join…"
                               Foreground="#94A3B8"
                               FontSize="18"
                               HorizontalAlignment="Center" />
                    <ProgressRing x:Name="JoiningSpinner"
                                  IsActive="False"
                                  Foreground="#2563EB"
                                  Width="32"
                                  Height="32" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Layer 1: Local video PiP (bottom-right) -->
        <Border x:Name="LocalVideoContainer"
                Width="160"
                Height="220"
                CornerRadius="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,96"
                Background="#334155"
                BorderBrush="#475569"
                BorderThickness="1">
            <Grid>
                <TextBlock x:Name="LocalVideoPlaceholder"
                           Text="You"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14" />
                <!-- Audio activity indicator -->
                <Border x:Name="AudioActivityBorder"
                        Width="4"
                        CornerRadius="2"
                        Background="#22C55E"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Margin="4,12"
                        Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Layer 2: Status overlay (reconnecting / error) -->
        <Grid x:Name="StatusOverlay"
              Background="#99000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsActive="True"
                              Foreground="#F59E0B"
                              Width="48"
                              Height="48" />
                <TextBlock x:Name="StatusText"
                           Text="Reconnecting…"
                           Foreground="#F8FAFC"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusSubText"
                           Text="Your connection was interrupted."
                           Foreground="#94A3B8"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Layer 3: Error screen -->
        <Grid x:Name="ErrorOverlay"
              Background="#0F172A"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <FontIcon Glyph=""
                          FontSize="48"
                          Foreground="#EF4444" />
                <TextBlock x:Name="ErrorMessage"
                           Text="An error occurred"
                           Foreground="#F8FAFC"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Button Content="Try Again"
                        Background="#2563EB"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="24,12"
                        Click="OnDismissClick" />
            </StackPanel>
        </Grid>

        <!-- Layer 4: Call controls (bottom toolbar) -->
        <StackPanel x:Name="CallToolbar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Spacing="20"
                    Background="#1E293B"
                    CornerRadius="16"
                    Padding="20,12">
            <!-- Microphone toggle -->
            <Button x:Name="MicButton"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Background="#334155"
                    Click="OnMicToggle">
                <FontIcon x:Name="MicIcon"
                          Glyph=""
                          FontSize="20"
                          Foreground="White" />
            </Button>
            <!-- Video toggle -->
            <Button x:Name="VideoButton"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Background="#334155"
                    Click="OnVideoToggle">
                <FontIcon x:Name="VideoIcon"
                          Glyph=""
                          FontSize="20"
                          Foreground="White" />
            </Button>
            <!-- End call -->
            <Button x:Name="EndCallButton"
                    Width="56" Height="56"
                    CornerRadius="28"
                    Background="#EF4444"
                    Click="OnEndCall">
                <FontIcon Glyph=""
                          FontSize="24"
                          Foreground="White" />
            </Button>
            <!-- Flip camera -->
            <Button x:Name="FlipCameraButton"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Background="#334155"
                    Click="OnFlipCamera">
                <FontIcon Glyph=""
                          FontSize="20"
                          Foreground="White" />
            </Button>
            <!-- Screen share -->
            <Button x:Name="ScreenShareButton"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Background="#334155"
                    Click="OnScreenShare">
                <FontIcon Glyph=""
                          FontSize="20"
                          Foreground="White" />
            </Button>
        </StackPanel>

        <!-- Layer 5: Top bar (room info) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,12,0,0"
                    Spacing="8">
            <FontIcon Glyph=""
                      FontSize="16"
                      Foreground="#64748B" />
            <TextBlock x:Name="RoomTitle"
                       Text="Serenada"
                       Foreground="#94A3B8"
                       FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
